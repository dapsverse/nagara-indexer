# Postgres the indexer owns. Nothing else should write to these tables.
DATABASE_URL=postgresql://user@localhost:5432/nagara_explorer

# Port for the read API consumed by the explorer frontend.
PORT=8787

# Both networks are pallet-ethereum/pallet-evm (Frontier) chains, read over
# plain JSON-RPC — no WS URL, no archive/backfill split (see the EVM design
# spec's "Known limitations"). mainnet's two RPC nodes (rpc1/rpc2.nagara.network)
# were verified live 2026-09-08 (chain id 16868, 4/4 peers, finalized == best
# block on both) at 203.145.34.119 / 103.217.144.105, but DNS/TLS for those
# hostnames was still being registered with Cloudflare at that point — if
# rpc1.nagara.network isn't resolving yet, override with the raw IP.
MAINNET_RPC_HTTP_URL=https://rpc1.nagara.network
MAINNET_CHAIN_ID=16868
TESTNET_RPC_HTTP_URL=https://testnet.nagara.network
TESTNET_CHAIN_ID=16869

# MINAR's contract address per network, when deployed there. Leave blank
# until it is — /balance simply omits MINAR from the response, it does not
# error. The old ink! mainnet's MINAR address does NOT carry over: this is a
# brand-new genesis chain, set this only once MINAR is redeployed as a
# Solidity ERC-20 here.
MAINNET_MINAR_ADDRESS=
TESTNET_MINAR_ADDRESS=

# Blocks fetched in parallel by the (now unused for both networks, kept for
# when the old ink! mainnet path is eventually removed) substrate backfill
# loop.
FETCH_CONCURRENCY=25

# Keys accepted on the `x-api-key` header. Comma-separated, so a key can be
# rotated by listing the old and new one together until every caller has moved.
#
# Leave EMPTY for local development — the check is then skipped and the server
# logs a warning at startup. Any deployment reachable from the internet must set
# this: without it every endpoint is world-readable.
#
# Generate one with: openssl rand -hex 32
API_KEYS=
