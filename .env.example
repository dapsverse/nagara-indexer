# Postgres the indexer owns. Nothing else should write to these tables.
DATABASE_URL=postgresql://user@localhost:5432/nagara_explorer

# Port for the read API consumed by the explorer frontend.
PORT=8787

# Live nodes. These prune old blocks, so they can only serve the recent tip.
MAINNET_WS_URL=wss://bootnode.nagara.network
TESTNET_WS_URL=wss://testnet.nagara.network

# Archive nodes. Required for any history older than the live nodes' pruning
# window — they discard old block bodies AND state, so nothing below it is
# reachable without an archive node synced from genesis. Leave blank until one
# exists; the backfill parks its cursor and resumes from there once set.
MAINNET_ARCHIVE_WS_URL=
TESTNET_ARCHIVE_WS_URL=

# Blocks fetched in parallel during backfill. Raise if the archive node can take it.
FETCH_CONCURRENCY=25

# Keys accepted on the `x-api-key` header. Comma-separated, so a key can be
# rotated by listing the old and new one together until every caller has moved.
#
# Leave EMPTY for local development — the check is then skipped and the server
# logs a warning at startup. Any deployment reachable from the internet must set
# this: without it every endpoint is world-readable.
#
# Generate one with: openssl rand -hex 32
API_KEYS=
